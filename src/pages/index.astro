---
import Base from '../layouts/Base.astro';
---
<Base pagina="cantar">
  <!-- Paso 1 -->
  <section class="tarjeta paso-1" id="paso1">
    <h2><span class="numero">1</span> Elige tu canción</h2>
    <div class="pestanas" role="tablist">
      <button class="pestana activa" data-tab="subir" role="tab">📁 Subir MP3</button>
      <button class="pestana" data-tab="youtube" role="tab">▶️ YouTube</button>
    </div>

    <div data-panel="subir">
      <label class="soltar" id="soltar">
        <span class="icono">🎵</span>
        <strong>Toca aquí para elegir la canción</strong>
        <small>MP3, M4A o WAV de tu celular</small>
        <input type="file" id="archivo" accept="audio/*,.mp3,.m4a,.wav,.ogg,.flac" />
      </label>
      <p class="elegido" id="elegido" hidden></p>
      <details class="nota ayuda-wa ayuda-archivo">
        <summary><b>📂 ¿No aparece tu canción?</b></summary>
        <p>Si en la ventana que se abre dice <b>“Sin elementos”</b>: toca el menú <b>☰</b> (arriba a la izquierda) → <b>Audio</b> o <b>Descargas</b> → toca la canción. ¡Y vuelve sola aquí!</p>
        <p>⚠️ No la busques desde el <b>Administrador de archivos</b>: ahí, al tocarla, se pone a sonar en vez de enviarse a Luza.</p>
      </details>
      <details class="nota ayuda-wa">
        <summary><b>💬 ¿La canción te llegó por WhatsApp?</b></summary>
        <p><b>Lo más fácil:</b> en WhatsApp mantén presionado el audio → toca <b>Compartir</b> (↗️) → elige <b>Luza</b>. ¡Se abre aquí solita!</p>
        <p><b>O búscala aquí:</b> toca “Elegir la canción” → menú ☰ → <b>Audio</b> o <b>Archivos</b> → carpeta <b>WhatsApp Audio</b> o <b>WhatsApp Documents</b>.</p>
      </details>
    </div>

    <div data-panel="youtube" hidden>
      <input class="campo" id="link" type="url" inputmode="url" placeholder="Pega aquí el link de YouTube" autocomplete="off" />
      <p class="nota">En YouTube toca <b>Compartir → Copiar enlace</b> y pégalo aquí. Si no funciona, descarga la canción y usa “Subir MP3”.</p>
    </div>
  </section>

  <!-- Paso 2 -->
  <section class="tarjeta paso-2 apagada" id="paso2">
    <h2><span class="numero">2</span> ¡Quitar la voz!</h2>
    <div class="modos" id="modos">
      <button class="boton boton-grande" id="con-ia">
        🪄 Quitar la voz con IA
        <span class="modo-desc">La mejor calidad · tarda 2 a 4 minutos</span>
      </button>
      <button class="boton boton-menta" id="rapido">
        ⚡ Modo rápido
        <span class="modo-desc">Al instante en el celular · calidad sencilla</span>
      </button>
    </div>
    <div class="progreso" id="progreso" hidden>
      <div class="bailando" aria-hidden="true"><span>🎵</span><span>🎤</span><span>🎶</span><span>✨</span></div>
      <div class="barra indeterminada" id="barra"><div></div></div>
      <p class="mensaje" id="mensaje" aria-live="polite">Preparando…</p>
    </div>
    <div class="error" id="error" hidden></div>
  </section>

  <!-- Paso 3 -->
  <section class="tarjeta paso-3" id="paso3" hidden>
    <h2><span class="numero">3</span> ¡A cantar! 🎉</h2>
    <p class="titulo-cancion" id="titulo-cancion"></p>
    <div id="reproductor"></div>
    <p class="guardada">✅ Guardada en <a href="/historial">Mis canciones</a></p>
    <button class="boton boton-suave" id="otra">🔄 Limpiar otra canción</button>
  </section>

  <script>
    import { decodificar, aMp3 } from '../scripts/audio.js';
    import { separarRapido } from '../scripts/modoRapido.js';
    import { separarConIA, motorConfigurado } from '../scripts/motor.js';
    import { guardar } from '../scripts/historial.js';
    import { montarReproductor } from '../scripts/reproductor.js';

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const paso2 = $('paso2');
    const paso3 = $('paso3');
    const archivoInput = $<HTMLInputElement>('archivo');
    const linkInput = $<HTMLInputElement>('link');
    const botonIA = $<HTMLButtonElement>('con-ia');
    const botonRapido = $<HTMLButtonElement>('rapido');
    const errorBox = $('error');
    let pestana = 'subir';
    let archivo: File | null = null;
    let reproductor: { detener: () => void } | null = null;

    // ---- Pestañas ----
    document.querySelectorAll<HTMLButtonElement>('.pestana').forEach((b) =>
      b.addEventListener('click', () => {
        pestana = b.dataset.tab!;
        document.querySelectorAll('.pestana').forEach((x) => x.classList.toggle('activa', x === b));
        document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== pestana));
        revisar();
      })
    );

    // ---- Elegir archivo ----
    function elegir(f?: File | null) {
      if (!f) return;
      archivo = f;
      const el = $('elegido');
      el.hidden = false;
      el.textContent = `🎶 ${f.name}`;
      revisar();
    }
    archivoInput.addEventListener('change', () => elegir(archivoInput.files?.[0]));
    const zona = $('soltar');
    zona.addEventListener('dragover', (e) => { e.preventDefault(); zona.classList.add('encima'); });
    zona.addEventListener('dragleave', () => zona.classList.remove('encima'));
    zona.addEventListener('drop', (e) => {
      e.preventDefault();
      zona.classList.remove('encima');
      elegir(e.dataTransfer?.files?.[0]);
    });
    linkInput.addEventListener('input', revisar);

    const esYoutube = (u: string) => /^(https?:\/\/)?(www\.|m\.|music\.)?(youtube\.com|youtu\.be)\//i.test(u.trim());

    function revisar() {
      const listo = pestana === 'subir' ? !!archivo : esYoutube(linkInput.value);
      paso2.classList.toggle('apagada', !listo);
      botonRapido.hidden = pestana === 'youtube';
    }

    // ---- Progreso ----
    function progreso(texto: string, valor: number | null = null) {
      $('mensaje').textContent = texto;
      const barra = $('barra');
      barra.classList.toggle('indeterminada', valor === null);
      (barra.firstElementChild as HTMLElement).style.width = valor === null ? '' : `${Math.max(5, valor * 100)}%`;
    }
    function ocupado(si: boolean) {
      $('modos').hidden = si;
      $('progreso').hidden = !si;
      document.querySelectorAll<HTMLButtonElement>('.pestana').forEach((b) => (b.disabled = si));
      archivoInput.disabled = si;
      linkInput.disabled = si;
    }
    function mostrarError(t: string) {
      errorBox.hidden = false;
      errorBox.textContent = `😕 ${t}`;
    }

    async function terminar(cancion: { titulo: string; instrumental: Blob; voz: Blob; modo: string }) {
      progreso('Guardando en Mis canciones… 💾');
      await guardar(cancion);
      ocupado(false);
      paso3.hidden = false;
      $('titulo-cancion').textContent = `🎵 ${cancion.titulo}`;
      reproductor?.detener();
      reproductor = montarReproductor($('reproductor'), cancion);
      paso3.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // ---- Con IA ----
    botonIA.addEventListener('click', async () => {
      errorBox.hidden = true;
      if (!motorConfigurado()) {
        mostrarError('Todavía no está configurado el motor de IA. Toca ⚙️ Ajustes, o usa el Modo rápido.');
        return;
      }
      ocupado(true);
      try {
        const entrada = pestana === 'subir' ? { archivo: archivo! } : { youtube: linkInput.value.trim() };
        const r = await separarConIA(entrada, progreso);
        await terminar({ ...r, modo: 'ia' });
      } catch (e: any) {
        ocupado(false);
        mostrarError(e?.message || 'Algo salió mal.');
      }
    });

    // ---- Modo rápido ----
    botonRapido.addEventListener('click', async () => {
      errorBox.hidden = true;
      if (!archivo) return;
      ocupado(true);
      try {
        progreso('Escuchando la canción… 👂');
        const buffer = await decodificar(archivo);
        if (buffer.numberOfChannels < 2) throw new Error('Esta canción es mono (un solo canal) y el modo rápido no puede quitarle la voz. Usa “Quitar la voz con IA”.');
        progreso('Quitando la voz… ✂️🎤');
        const { instrumental, voz } = await separarRapido(buffer);
        const instMp3 = await aMp3(instrumental, { kbps: 128, alAvanzar: (p) => progreso('Preparando la pista… 🎹', p * 0.6) });
        const vozMp3 = await aMp3(voz, { kbps: 96, alAvanzar: (p) => progreso('Preparando la voz… 🎤', 0.6 + p * 0.4) });
        await terminar({ titulo: archivo.name.replace(/\.[^.]+$/, ''), instrumental: instMp3, voz: vozMp3, modo: 'rapido' });
      } catch (e: any) {
        ocupado(false);
        mostrarError(e?.message || 'No se pudo leer ese archivo de audio.');
      }
    });

    // ---- Otra canción ----
    $('otra').addEventListener('click', () => {
      reproductor?.detener();
      paso3.hidden = true;
      archivo = null;
      archivoInput.value = '';
      linkInput.value = '';
      $('elegido').hidden = true;
      revisar();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // ---- Canción o link compartidos desde WhatsApp (Compartir → Luza) ----
    async function recibirCompartido() {
      const params = new URLSearchParams(location.search);
      const link = params.get('link');
      if (params.has('compartido')) {
        try {
          const cache = await caches.open('luza-compartido');
          const r = await cache.match('/compartido');
          if (r) {
            const nombre = decodeURIComponent(r.headers.get('X-Nombre') || 'Canción');
            elegir(new File([await r.blob()], nombre, { type: r.headers.get('Content-Type') || 'audio/mpeg' }));
            await cache.delete('/compartido');
            $('elegido').textContent = `💬 Recibida de WhatsApp: ${nombre}`;
          }
        } catch {}
      } else if (link && esYoutube(link)) {
        (document.querySelector('[data-tab="youtube"]') as HTMLButtonElement).click();
        linkInput.value = link;
        revisar();
      }
      if (params.size) history.replaceState(null, '', '/');
      if (archivo || linkInput.value) paso2.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    revisar();
    recibirCompartido();
  </script>
</Base>
