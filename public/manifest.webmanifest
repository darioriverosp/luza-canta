{
  "id": "/",
  "name": "Luza Canta",
  "short_name": "Luza",
  "description": "Quita la voz a tus canciones y canta karaoke con tu club.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#2a1074",
  "theme_color": "#5a1fd1",
  "icons": [
    {
      "src": "/icons/icono-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icono-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icono-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/recibir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".mp3",
            ".mpeg",
            ".mpga",
            ".m4a",
            ".ogg",
            ".opus",
            ".wav",
            ".aac",
            ".flac"
          ]
        }
      ]
    }
  }
}
