# Dirección del motor que la web usa para quitar la voz con IA.
#
# Opciones:
#   1. El de siempre (en Modal):
#      PUBLIC_MOTOR_URL=https://darioriverosp--luza-motor.modal.run
#   2. El motor corriendo en tu PC (ver motor/leeme.md): pega aquí la URL fija
#      de tu túnel, por ejemplo:
#      PUBLIC_MOTOR_URL=https://luza-1234.ngrok-free.app
#
# Si el motor principal no responde (PC apagada), la web intenta igual con el
# de Modal; nada que configurar aparte.
PUBLIC_MOTOR_URL=https://darioriverosp--luza-motor.modal.run
